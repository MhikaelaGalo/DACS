{
  "name": "dacs-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "dev:test": "tsx watch --env-file=.env.test src/server.ts",
    "start:test": "tsx --env-file=.env.test src/server.ts",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:studio": "prisma studio",
    "test:setup": "tsx scripts/setup-test-db.ts",
    "test:backend": "tsx scripts/test-backend.ts",
    "test:deletes": "tsx scripts/test-deletes.ts",
    "test:rbac": "tsx scripts/test-admin-rbac.ts",
    "test:provisioning": "tsx scripts/test-user-provisioning.ts",
    "test:gaps": "tsx scripts/test-integration-gaps.ts",
    "test:analytics": "tsx scripts/test-analytics-builder.ts",
    "test:seminar-content": "tsx scripts/test-seminar-content.ts",
    "test:seminar-purchases": "tsx scripts/test-seminar-purchases.ts",
    "test:certificates": "tsx scripts/test-certificate-issuance.ts",
    "test:historical": "tsx scripts/test-historical-lossless.ts",
    "test:orders": "tsx scripts/test-historical-orders.ts",
    "test:security": "tsx scripts/test-security-audit.ts",
    "test:all": "npm run test:backend && npm run test:deletes && npm run test:rbac && npm run test:provisioning && npm run test:gaps && npm run test:analytics && npm run test:seminar-content && npm run test:seminar-purchases && npm run test:certificates && npm run test:historical && npm run test:orders && npm run test:security",
    "test": "npm run test:all"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.0",
    "@prisma/client": "^7.9.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "firebase-admin": "^14.2.0",
    "helmet": "^8.3.0",
    "jszip": "^3.10.1",
    "multer": "^2.2.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "nodemon": "^3.1.14",
    "prisma": "^7.9.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
