# Template for .env.test — the DACS automated-test environment.
# Copy to .env.test and fill in the placeholders. See .env for the
# development counterpart; the two must point at DIFFERENT databases.
#
# The database name MUST contain "test" (e.g. dacs_test_db) — the test
# runner and the server both refuse to start otherwise. Create and
# migrate it with:  npm run test:setup

DATABASE_URL="postgresql://<db-user>:<db-password>@localhost:5432/dacs_test_db?schema=public"

# Port for the test server (npm run dev:test). Keep it different from the
# dev server's PORT so both can run at once.
PORT=5001

GOOGLE_APPLICATION_CREDENTIALS="<absolute path to the Firebase Admin service-account JSON>"

SESSION_MAX_AGE_HOURS=12

# Physical folder for files uploaded during test runs (relative to the
# backend root). Keeps test uploads out of the real uploads/ folder.
UPLOADS_DIR=uploads-test

# Required: makes src/config/database.ts refuse any non-test database.
DACS_TEST_MODE=1
