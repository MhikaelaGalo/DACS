# Copy these settings into the backend .env (or your host's backend environment).
# Apply the order_confirmation_emails migration and restart the backend.
# New checkouts queue an email when both sender settings are populated.
# Use your Gmail address and a Google App Password for that same account.
ORDER_EMAIL_FROM=
GMAIL_APP_PASSWORD=

# Demo payment details from the sample receipt. Replace before taking payments.
# Use the same proof inbox as the website checkout (currently dacs@gmail.com).
ORDER_GCASH_NAME="DACS Poultry Payments"
ORDER_GCASH_NUMBER="0000 000 0000"
ORDER_BANK_NAME="BDO Unibank"
ORDER_BANK_ACCOUNT_NAME="Dominant Asia Poultry Genetics"
ORDER_BANK_ACCOUNT_NUMBER="0000 0000 0000"
ORDER_PAYMENT_PROOF_EMAIL="payments@dacs.example"
