# Copy these settings into the backend .env and the live backend's environment.
# Keep the existing DATABASE_URL and Firebase settings. Never commit real keys.
SEMINAR_STORAGE_DRIVER=neon
AWS_ENDPOINT_URL_S3=https://YOUR-BRANCH.storage.YOUR-REGION.aws.neon.tech
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=YOUR_STORAGE_ACCESS_KEY_ID
AWS_SECRET_ACCESS_KEY=YOUR_STORAGE_SECRET_ACCESS_KEY
SEMINAR_COVERS_BUCKET=dacs-seminar-covers
SEMINAR_VIDEOS_BUCKET=dacs-seminar-videos
SEMINAR_CERTIFICATES_BUCKET=dacs-farmer-certificates
SEMINAR_VIDEO_LINK_SECONDS=3600
